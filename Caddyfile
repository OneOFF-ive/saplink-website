{
    admin off
    auto_https off
    persist_config off
    servers {
        protocols h1 h2
    }
}

(site_content) {
    root * /srv
    encode zstd gzip

    @latest path /downloads/latest /downloads/latest/* /releases.json
    header @latest Cache-Control "no-store"

    rewrite /releases.json /downloads/latest/releases.json

    @installers path /downloads/*/*.exe
    header @installers Content-Disposition "attachment"
    header X-Content-Type-Options "nosniff"

    file_server
    log
}

:8080 {
    import site_content
}

https://saplink.cloud:8443, https://www.saplink.cloud:8443 {
    tls /etc/caddy/certs/fullchain.pem /etc/caddy/certs/privkey.pem
    import site_content
}
